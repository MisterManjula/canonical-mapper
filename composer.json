{
    "name": "canonical/canonical-mapper",
    "description": "Maps three incompatible point-of-sale export formats into one canonical menu model",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "CanonicalMapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CanonicalMapper\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Fixtures/PhpStan/"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
